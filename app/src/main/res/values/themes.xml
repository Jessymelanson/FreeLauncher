<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        The home screen window.

        windowShowWallpaper is the whole point: it tells the window manager to
        draw the user's wallpaper behind this window, which is what lets the
        launcher scroll over it and lets live wallpapers run. It only works if
        the window background is actually transparent, hence the pairing below
        ; an opaque windowBackground silently defeats it and you get a flat
        colour with no error anywhere.

        windowDisablePreview suppresses the starting window. For most apps the
        preview is a courtesy; for a launcher it is a flash of empty chrome
        every single time Home is pressed.
    -->
    <style name="Theme.FreeLauncher" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <!--
        Settings is a normal window: opaque, no wallpaper, ordinary animations.
        Compose paints the surface, so the only thing asked of the platform
        theme is that it stays out of the way.
    -->
    <style name="Theme.FreeLauncher.Settings" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
        The pin confirmation window. Translucent so the Compose layer can draw
        its own scrim and card over whatever is behind, and with no starting
        preview: it is summoned from another app and a flash of empty chrome
        on the way in reads as that app having crashed.
    -->
    <style name="Theme.FreeLauncher.Pin" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
