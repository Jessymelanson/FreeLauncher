<?xml version="1.0" encoding="utf-8"?>
<!--
    108dp square, which is the whole adaptive-icon canvas. The system masks it
    to whatever shape the phone uses and may parallax it, so the gradient runs
    corner to corner rather than edge to edge: a linear gradient on one axis
    develops a visible seam once the launcher shifts the layer sideways.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF2B2D6E" />
                <item android:offset="0.55" android:color="#FF4B3FA8" />
                <item android:offset="1.0" android:color="#FF7C4DD1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
