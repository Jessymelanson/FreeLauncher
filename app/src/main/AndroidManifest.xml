<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Swipe down on the home screen to pull the shade. This is the one system
        UI gesture a launcher has to ask for by name; everything else it does is
        either an ordinary intent or goes through LauncherApps.
    -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!--
        Removing an app from a long-press menu. Without this the uninstall
        dialog still appears, but the launcher cannot be the one to ask for it
        on API 26+ and the request is bounced back.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
        Vibration on drag pick-up and on the long-press menu. Cosmetic, but a
        launcher without it feels dead under the finger.
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        Receiving the pre-Android-8 "add this to the home screen" broadcast.
        The modern path needs no permission; this one does, and without it the
        broadcast is never delivered.
    -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <!--
        Private space, Android 15+.

        ACCESS_HIDDEN_PROFILES is what makes the private profile appear in
        UserManager.getUserProfiles() at all. Without it the profile is not
        merely unreadable, it is invisible: the launcher cannot tell that
        private space exists, so there is nothing to offer a way into. It is a
        normal permission, granted on install, and it is the permission the
        platform added for launchers to do exactly this.

        MODIFY_QUIET_MODE is what lets the lock come off. Quiet mode is the
        same switch that pauses a work profile, and asking for it to be lifted
        is what raises the system's credential prompt ; this app never sees
        the PIN itself. The permission comes with the default-launcher role, so it
        is held only while FreeLauncher is actually the home screen;
        every call is written to survive being refused.
    -->
    <uses-permission android:name="android.permission.ACCESS_HIDDEN_PROFILES" />
    <uses-permission android:name="android.permission.MODIFY_QUIET_MODE" />

    <!--
        Package visibility, API 30+.

        A launcher has to see every launchable app or it has nothing to show. It
        does NOT need QUERY_ALL_PACKAGES to do that: declaring the MAIN/LAUNCHER
        intent here makes exactly the apps that appear in an app drawer visible
        and nothing else, which is both narrower and the form Play expects from
        a launcher. QUERY_ALL_PACKAGES would need a policy declaration and would
        grant far more than this app reads.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

        <!--
            Sending a dead icon to the store.

            An app market is visible through the MAIN/LAUNCHER query above only
            because it happens to have a launcher icon, which is not something
            to rely on. Naming the two schemes the offer actually uses makes the
            market:// attempt resolvable in its own right, so a phone with a
            store app opens the store rather than falling through to a browser.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>

        <!--
            Icon packs.

            A pack is an ordinary app that declares one of these actions, and
            without naming them here it is invisible: queryIntentActivities
            returns nothing and getResourcesForApplication is refused, so the
            picker would be permanently empty on any phone running API 30 or
            later. Three actions because the convention was copied three times
            and packs declare whichever their author had heard of.

            This grants visibility of icon packs and nothing else, which is
            narrower than it looks: a pack that declares none of these is not
            visible, and neither is any other app.
        -->
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.gau.go.launcherex.theme" />
        </intent>
    </queries>

    <application
        android:name=".FreeLauncherApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FreeLauncher">

        <!--
            The home screen itself.

            The flag combination here is what separates a launcher from an
            ordinary activity, and each one is load-bearing:

            - launchMode="singleTask" plus clearTaskOnLaunch: pressing Home from
              inside another app must land on a fresh home screen, not on
              whatever folder happened to be open three days ago.
            - stateNotNeeded="true": the system kills and restarts a launcher
              freely under memory pressure, and is allowed to do so without ever
              calling onSaveInstanceState. An activity that has not opted in
              here is simply not restarted, and the phone is left with no home
              screen.
            - excludeFromRecents: the home screen is not a place you switch back
              to from the task switcher, it is the thing behind the switcher.
            - screenOrientation is left unspecified: the home screen follows the
              device. It was pinned to portrait for a while as a way round a
              landscape layout that came out wrong, and the layout is fixed
              now, so the pin is gone. Several devices ignored it anyway, which
              is what made fixing the layout the only real option.
            - resizeableActivity plus the configChanges list: the activity still
              has to survive other configuration changes, such as multi window
              resizing, a density change or a theme switch. Recreating on those
              drops the drawer, the open folder and the drag in progress, and
              handling them is much cheaper than rebuilding the whole workspace.
            - windowSoftInputMode=adjustPan so the drawer's search field lifts
              above the keyboard without the grid behind it reflowing.
        -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|smallestScreenSize|density|uiMode"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="unspecified"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustPan">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!--
                    Lets the monkey stress tester and the CTS home-screen checks
                    drive this activity. Harmless, and its absence is a common
                    reason a launcher is skipped by automated testing.
                -->
                <category android:name="android.intent.category.MONKEY" />
            </intent-filter>
        </activity>

        <!--
            Settings as a separate, ordinary activity rather than a screen
            inside the home task.

            This is what makes FreeLauncher configurable *before* it is the
            default launcher: MainActivity answers only to HOME, so until the
            user switches over there would otherwise be no way to open this app
            at all. It is also the only entry that appears in an app drawer,
            which is the right way round ; the home screen is not something you
            tap an icon to reach.

            taskAffinity is its own, and without it this entry stopped opening
            the moment FreeLauncher became the home app.

            A launcher starts an app through LauncherApps.startMainActivity,
            which sends MAIN/LAUNCHER with NEW_TASK and RESET_TASK_IF_NEEDED.
            With the default affinity this activity shares a task identity with
            MainActivity, and MainActivity is singleTask and the root of the
            home task ; so the system found that task, decided this launch
            belonged to it, and delivered the intent to MainActivity instead of
            starting anything. The log line is "Activity not started, intent has
            been delivered to currently running top-most instance", and what the
            user sees is the home screen they were already looking at. Tapping
            the icon appeared to do nothing.

            Before the switch there is no home task to collide with, which is
            why it worked right up until it mattered.

            Opening settings from inside the launcher was never affected:
            affinity is only consulted for a NEW_TASK launch, and that route is
            an ordinary startActivity within the task that is already running.
        -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/settings_label"
            android:screenOrientation="unspecified"
            android:taskAffinity="com.freelauncher.app.settings"
            android:theme="@style/Theme.FreeLauncher.Settings"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            "Add to home screen", asked for by another app.

            This is what makes a browser's Add to Home screen work. An app
            cannot pin anything itself: it calls requestPinShortcut, and the
            system asks the current home screen whether it handles
            CONFIRM_PIN_SHORTCUT. A launcher without this activity is reported
            as not supporting pinning at all, so the option is greyed out or
            silently does nothing ; no error anywhere, the feature simply is
            not there.

            taskAffinity is empty and excludeFromRecents is set so this never
            joins the home screen's task or appears in the recents list; it is
            a confirmation, not a place.
        -->
        <activity
            android:name=".PinItemActivity"
            android:autoRemoveFromRecents="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:taskAffinity=""
            android:theme="@style/Theme.FreeLauncher.Pin">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
                <action android:name="android.content.pm.action.CONFIRM_PIN_APPWIDGET" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Notification dots.

            The only way any app can know that another app has a notification,
            and it is gated behind a grant the user makes by hand in system
            settings, on a screen that warns them what it allows. That is
            proportionate: the same grant lets a listener read the text of every
            notification on the phone. So this service is declared but does
            nothing until it is bound, the setting that asks for it is off by
            default, and the only thing taken from a notification here is the
            name of the package that posted it.

            exported is true because the thing that binds this is the system,
            from another process. It is not open to anyone: the BIND permission
            below is held only by the system, so a service declaring it can be
            bound by nothing else.
        -->
        <service
            android:name=".data.LauncherNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The pre-Android-8 equivalent, for apps that still send it. -->
        <receiver
            android:name=".InstallShortcutReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.launcher.action.INSTALL_SHORTCUT" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
